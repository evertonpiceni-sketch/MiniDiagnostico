# Public application URL used for Stripe redirects.
APP_URL="https://your-domain.example"

# Gemini (server-side only; never expose a secret key as VITE_*).
GEMINI_API_KEY=

# Stripe (server-side only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional email delivery.
RESEND_API_KEY=

# Persistent production database (Supabase/PostgREST).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# CORS. Set to the exact public origin in production.
CORS_ORIGIN="https://your-domain.example"
