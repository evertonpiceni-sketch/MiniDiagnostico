# Public application URL (no trailing slash)
APP_URL="https://seu-dominio.example"
# Comma-separated browser origins allowed to call the API. Usually the same as APP_URL.
CORS_ORIGIN="https://seu-dominio.example"

# Supabase — SERVER ONLY. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini (only if/when the server uses Gemini)
GEMINI_API_KEY=""

# Stripe — use live values in production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Optional transactional email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Mini Diagnóstico <onboarding@resend.dev>"
