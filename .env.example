# Public application URL used for Stripe redirects.
APP_URL="https://your-domain.example"

# Gemini (server-side only; never expose a secret key as VITE_*).
GEMINI_API_KEY=

# Stripe (server-side only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# At least 32 random characters. Used to sign private result/PDF links.
RESULT_TOKEN_SECRET=
CRON_SECRET=

# Persistent production database (Supabase/PostgREST).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# CORS. Set to the exact public origin in production.
CORS_ORIGIN="https://your-domain.example"

# WhatsApp Cloud API (server-side only).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
