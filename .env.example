# Public application URL used for Asaas payment redirects.
APP_URL="https://your-domain.example"

# Asaas (server-side only; PIX + credit card).
ASAAS_API_KEY=
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=

# At least 32 random characters. Used to sign private result/PDF links.
RESULT_TOKEN_SECRET=

# Optional dedicated secret for ADM/support/test sessions. If omitted, the server derives
# a session signing key from other configured server-side secrets.
ADMIN_SESSION_SECRET=

# ADM/test access credentials. Use strong unique passwords in Vercel; never commit real values.
JANAINA_ADMIN_PASSWORD=
JANAINA_TEST_PASSWORD=

# Persistent production database (Supabase/PostgREST).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (optional delivery/integration).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Local-development only. Set true when HMR/file watching must be disabled.
DISABLE_HMR="false"
